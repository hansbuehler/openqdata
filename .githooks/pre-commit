#!/bin/sh
# Use the active project environment; never install packages or fetch fixtures.
set -eu
cd "$(git rev-parse --show-toplevel)"
scratch_base="${TMPDIR:-/tmp}/quant_data"
mkdir -p "$scratch_base"
scratch="$(mktemp -d "$scratch_base/quantdata-pre-commit.XXXXXXXX")"
trap 'rm -rf "$scratch"' EXIT
export PYTHONDONTWRITEBYTECODE=1
"${QUANTDATA_TEST_PYTHON:-python}" -m pytest -q -p no:cacheprovider \
    --basetemp="$scratch/pytest" tests
